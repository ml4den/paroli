run = "python -m http.server 5000 --bind 0.0.0.0"
modules = ["python-base-3.13", "nodejs-24"]
hidden = [".config", ".gitignore", "node_modules"]

[deployment]
deploymentTarget = "static"
publicDir = "."

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m http.server 5000 --bind 0.0.0.0"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
